# ─── SkiHub (Snowbreak) — Variables de entorno ──────────────────────────────
# Copia este fichero a `.env` y rellena los valores reales.
# El fichero `.env` NUNCA se sube al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────────────────────
# development | production
# En production: COOKIE_SECURE=1, DB_SSLMODE distinto de "disable", CSRF_SECRET
# obligatorio (32+ chars), HSTS activo, etc.
APP_ENV=development

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario_bd
DB_PASSWORD=cambia_esto_por_una_contrasena_segura
DB_NAME=tu_nombre_bd
# Modos válidos: disable | require | verify-ca | verify-full
# - disable: solo desarrollo local
# - require: producción mínima (cifrado, sin validar CA)
# - verify-full: producción recomendada
DB_SSLMODE=disable

# Tamaño del pool de conexiones (opcionales, valores por defecto sensatos)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MIN=30

# ── Servidor HTTP ────────────────────────────────────────────────────────────
APP_PORT=:8080
APP_TEMPLATES=web/templates
APP_STATIC=web/static

# ── Seguridad ────────────────────────────────────────────────────────────────
# CSRF_SECRET — semilla del HMAC para los tokens CSRF.
#   - 32+ caracteres aleatorios.
#   - Generar con: openssl rand -hex 32
#   - Si está vacía en development se genera una efímera al arrancar.
#   - OBLIGATORIA en production.
CSRF_SECRET=

# COOKIE_SECURE — emite cookies con flag Secure (solo HTTPS).
#   true en producción detrás de TLS; false en localhost sin TLS.
#   Si se omite, por defecto se activa cuando APP_ENV=production.
# COOKIE_SECURE=true

# TRUST_PROXY — confía en X-Forwarded-For/X-Real-IP (solo si la app está
# detrás de un reverse proxy de tu confianza, p.ej. Nginx/Cloudflare).
TRUST_PROXY=false

# Tamaño máximo (bytes) de cuerpo POST/PUT que aceptamos. Defensa básica
# contra body-flooding. Default 1 MiB.
BODY_MAX_BYTES=1048576

# Peticiones por minuto por IP en endpoints sensibles (login, registro,
# checkout, favoritos, parte refresh). Default 30.
RATE_LIMIT_PER_MIN=30

# ── Administrador inicial ────────────────────────────────────────────────────
# Si al arrancar no existe ningún admin, se crea uno con estos datos.
# Cambia la contraseña tras el primer login.
# En producción la contraseña debe tener al menos 12 caracteres.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=pon_aqui_password_segura_12chars

# ── URL base de la aplicación ────────────────────────────────────────────────
# Se usa para construir enlaces absolutos en los emails (confirmar email,
# resets de contraseña en el futuro, etc.) y como redirect URL por defecto
# de Google OAuth si GOOGLE_REDIRECT_URL no se define.
#   - local:      http://localhost:8080
#   - producción: https://snowbreak.es
APP_BASE_URL=http://localhost:8080

# ── Google OAuth / OpenID Connect ────────────────────────────────────────────
# Crea credenciales OAuth en https://console.cloud.google.com/apis/credentials
#   - Tipo "Aplicación web".
#   - Authorized redirect URI: el mismo valor de GOOGLE_REDIRECT_URL.
# Si las dos primeras están vacías, /auth/google devuelve 503 (Google login
# desactivado) y el resto de la app sigue funcionando con login email/pass.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ── SMTP (envío de emails de verificación y bienvenida) ──────────────────────
# Ejemplos típicos:
#   - Mailgun:   SMTP_HOST=smtp.mailgun.org    SMTP_PORT=587
#   - SendGrid:  SMTP_HOST=smtp.sendgrid.net   SMTP_PORT=587  SMTP_USER=apikey
#   - SES:       SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587
#   - Mailhog:   SMTP_HOST=localhost  SMTP_PORT=1025 (sin auth, EMAIL_DISABLED=false)
# Todos los envíos usan STARTTLS sobre el puerto indicado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@snowbreak.es
SMTP_FROM_NAME=Snowbreak

# EMAIL_DISABLED=true en desarrollo loguea el enlace de confirmación por
# stdout en vez de enviar correo. Útil cuando no tienes SMTP configurado.
# Si SMTP_HOST está vacío también se considera desactivado por seguridad.
EMAIL_DISABLED=true
