{{define "contenido"}}
<section class="hero hero--home">
  <h1 class="hero__title">Crea tu cuenta en SnowBreak</h1>
  <p class="hero__subtitle">Regístrate gratis y guarda tus estaciones favoritas, gestiona tus forfaits y planifica tus escapadas en un par de clics.</p>
</section>

<section class="container section-stack">
  <div class="panel panel--form">
    {{if .Error}}
      <div class="alert alert--error" role="alert">
        {{.Error}}
      </div>
    {{end}}

    <form method="POST" action="/registro" class="form-stack">
      <input type="hidden" name="csrf_token" value="{{.CSRF}}">
      <div class="form-field">
        <label for="nombre" class="form-label">Nombre</label>
        <input id="nombre" name="nombre" type="text" required minlength="2" maxlength="60" value="{{.Form.Nombre}}" class="form-input">
      </div>

      <div class="form-field">
        <label for="email" class="form-label">Correo electrónico</label>
        <input id="email" name="email" type="email" required maxlength="120" value="{{.Form.Email}}" class="form-input">
      </div>

      <div class="form-field">
        <label for="password" class="form-label">Contraseña</label>
        <input id="password" name="password" type="password" required minlength="8" maxlength="128" class="form-input">
        <small class="form-help">Mínimo 8 caracteres.</small>
      </div>

      <div class="form-field">
        <label for="password2" class="form-label">Repite la contraseña</label>
        <input id="password2" name="password2" type="password" required minlength="8" maxlength="128" class="form-input">
      </div>

      <button type="submit" class="navbar__btn form-submit">Crear cuenta</button>
    </form>

    <div class="auth-divider" role="separator" aria-orientation="horizontal">
      <span>o</span>
    </div>

    <a href="/auth/google" class="auth-google-btn" rel="nofollow">
      <svg class="auth-google-btn__icon" viewBox="0 0 24 24" width="18" height="18" focusable="false" aria-hidden="true">
        <path fill="currentColor" d="M12.48 10.92v3.28h7.84c-.24 1.84-.85 3.18-1.73 4.1-1.08 1.07-2.77 2.27-5.71 2.27-4.55 0-8.11-3.67-8.11-8.22s3.56-8.22 8.11-8.22c2.45 0 4.25.96 5.58 2.21l2.31-2.31C18.88 2.41 16.5 1 12.48 1 5.88 1 .28 6.43.28 13.03s5.6 12.03 12.2 12.03c3.74 0 6.55-1.22 8.78-3.54 2.27-2.27 2.98-5.45 2.98-8.04 0-.83-.07-1.6-.21-2.31H12.48z"/>
      </svg>
      <span class="auth-google-btn__label">Continuar con Google</span>
    </a>

    <p class="form-footnote">
      ¿Ya tienes cuenta?
      <a href="/login" class="text-link">Inicia sesión</a>
    </p>
  </div>
</section>
{{end}}
