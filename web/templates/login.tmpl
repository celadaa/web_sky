{{define "contenido"}}
<section class="hero hero--home">
  <h1 class="hero__title">Inicia sesión en SnowBreak</h1>
  <p class="hero__subtitle">Accede para guardar tus estaciones favoritas, ver tus forfaits y mantener tus preferencias entre dispositivos.</p>
</section>

<section class="container section-stack">
  <div class="panel panel--form">
    {{if .Mensaje}}
      <div class="alert alert--success" role="status">
        {{.Mensaje}}
      </div>
    {{end}}
    {{if .Error}}
      <div class="alert alert--error" role="alert">
        {{.Error}}
      </div>
    {{end}}

    <form method="POST" action="/login" class="form-stack">
      <input type="hidden" name="csrf_token" value="{{.CSRF}}">
      <div class="form-field">
        <label for="email" class="form-label">Correo electrónico</label>
        <input id="email" name="email" type="email" required maxlength="120" value="{{.Email}}" autocomplete="email" class="form-input">
      </div>

      <div class="form-field">
        <label for="password" class="form-label">Contraseña</label>
        <div class="form-field--password-wrap">
          <input id="password" name="password" type="password" required minlength="8" maxlength="128" autocomplete="current-password" class="form-input">
          <button type="button" class="password-toggle" aria-label="Mostrar contraseña" data-target="password">
            <svg class="eye-icon eye-icon--show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="eye-icon eye-icon--hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
          </button>
        </div>
      </div>

      <button type="submit" class="navbar__btn form-submit">Entrar</button>
    </form>

    <div class="auth-trust-signals" role="note" aria-label="Información de seguridad">
      <span class="trust-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Conexión cifrada SSL
      </span>
      <span class="trust-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Tus datos están protegidos
      </span>
      <span class="trust-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Nunca compartimos tu información
      </span>
    </div>

    <div class="auth-divider" role="separator" aria-orientation="horizontal">
      <span>o</span>
    </div>

    <a href="/auth/google" class="auth-google-btn" rel="nofollow">
      <svg class="auth-google-btn__icon" viewBox="0 0 24 24" width="18" height="18" focusable="false" aria-hidden="true">
        <path fill="currentColor" d="M12.48 10.92v3.28h7.84c-.24 1.84-.85 3.18-1.73 4.1-1.08 1.07-2.77 2.27-5.71 2.27-4.55 0-8.11-3.67-8.11-8.22s3.56-8.22 8.11-8.22c2.45 0 4.25.96 5.58 2.21l2.31-2.31C18.88 2.41 16.5 1 12.48 1 5.88 1 .28 6.43.28 13.03s5.6 12.03 12.2 12.03c3.74 0 6.55-1.22 8.78-3.54 2.27-2.27 2.98-5.45 2.98-8.04 0-.83-.07-1.6-.21-2.31H12.48z"/>
      </svg>
      <span class="auth-google-btn__label">Continuar con Google</span>
    </a>

    <p class="form-footnote">
      ¿Todavía no tienes cuenta?
      <a href="/registro" class="text-link">Regístrate</a>
    </p>
  </div>
</section>
<style>
.form-field--password-wrap { position: relative; }
.form-field--password-wrap .form-input { padding-right: 2.8rem; }
.password-toggle {
  position: absolute; right: .75rem; top: 50%; transform: translateY(-50%);
  background: none; border: none; cursor: pointer; color: var(--color-text-muted, #6b7280);
  padding: .25rem; line-height: 0;
}
.password-toggle:hover { color: var(--color-primary, #1a6fc4); }
.auth-trust-signals {
  display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; justify-content: center;
  margin-top: 1rem; padding-top: .75rem; border-top: 1px solid var(--color-border, #e5e7eb);
}
.trust-item {
  display: flex; align-items: center; gap: .35rem;
  font-size: .75rem; color: var(--color-text-muted, #6b7280);
}
</style>
<script>
document.querySelectorAll('.password-toggle').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var input = document.getElementById(btn.dataset.target);
    var isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    btn.querySelector('.eye-icon--show').hidden = isPassword;
    btn.querySelector('.eye-icon--hide').hidden = !isPassword;
    btn.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
  });
});
</script>
{{end}}
